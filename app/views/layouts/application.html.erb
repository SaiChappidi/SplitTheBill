<!DOCTYPE html>
<html>
  <head>
    <title><%= yield(:title) || "Split the Bill" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta charset="utf-8">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header>
      <nav class="navbar">
        <ul>
          <li><%= link_to "Home", root_path %></li>
          
          <% if logged_in? %>
            <li><%= link_to "My Trips", trips_path %></li>
            <li>Logged in as: <strong><%= current_user.name %></strong></li>
            <li><%= link_to "Logout", logout_path, data: { turbo_method: :delete } %></li>
          <% else %>
            <li><%= link_to "Login", login_path %></li>
            <li><%= link_to "Sign Up", signup_path %></li>
          <% end %>
        </ul>
      </nav>
    </header>

    <% if flash.any? %>
      <div id="flash-messages">
        <% flash.each do |key, message| %>
          <div class="flash <%= key %>">
            <%= message %>
          </div>
        <% end %>
      </div>
    <% end %>

    <main class="container">
      <%= yield %>
    </main>

    <footer class="footer">
      <p>&copy; <%= Time.now.year %> Split the Bill</p>
    </footer>
  </body>
</html>