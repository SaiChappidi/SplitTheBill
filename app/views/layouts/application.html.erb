<!DOCTYPE html>
<html>
  <head>
    <title><%= yield(:title) || "Split the Bill" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta charset="utf-8">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="page-bg"></div>
    <header class="site-header">
      <nav class="navbar container">
        <%= link_to "Split the Bill", root_path, class: "brand" %>

        <% if logged_in? %>
          <div class="nav-links">
            <%= link_to "Trips", trips_path, class: "nav-link" %>
            <span class="user-chip"><%= current_user.name %></span>
            <%= link_to "Logout", logout_path, class: "nav-link", data: { turbo_method: :delete } %>
          </div>
        <% else %>
          <div class="nav-links">
            <%= link_to "Login", login_path, class: "nav-link" %>
            <%= link_to "Sign Up", signup_path, class: "btn btn-small" %>
          </div>
        <% end %>
      </nav>
    </header>

    <% if flash.any? %>
      <div id="flash-messages" class="container flash-stack">
        <% flash.each do |key, message| %>
          <div class="flash <%= key %>">
            <%= message %>
          </div>
        <% end %>
      </div>
    <% end %>

    <main class="container main-content">
      <%= yield %>
    </main>

    <footer class="footer container">
      <p>Built for smarter group trips. &copy; <%= Time.now.year %> Split the Bill</p>
    </footer>
  </body>
</html>