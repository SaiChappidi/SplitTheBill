<section class="card form-card">
  <h1><%= @expense.new_record? ? "Add Expense" : "Edit Expense" %></h1>
  <p style="margin-bottom: 1.3rem;">
    Log what was paid and choose who shares the cost.
  </p>

  <% if @expense.errors.any? %>
    <div class="error-box">
      <h2><%= pluralize(@expense.errors.count, "error") %> prevented this expense from being saved:</h2>
      <ul>
        <% @expense.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with(model: [@trip, @expense]) do |f| %>
    <div class="form-grid">
      <div class="field">
        <%= f.label :description %>
        <%= f.text_field :description, placeholder: "Dinner at Riverfront Grill" %>
      </div>

      <div class="field">
        <%= f.label :amount %>
        <%= f.number_field :amount, step: "0.01", min: "0.01", placeholder: "0.00" %>
      </div>

      <div class="field">
        <%= f.label :date %>
        <%= f.date_field :date %>
      </div>

      <div class="field">
        <%= f.label :category %>
        <%= f.select :category, Expense::CATEGORIES, {}, class: "input-select" %>
      </div>
    </div>

    <div class="field">
      <label>Who shares this expense?</label>
      <p class="field-help">Enter custom amounts per person. Leave an amount blank to split the remaining balance evenly among the selected people.</p>
      <div class="participant-list">
        <% @participants.each do |participant| %>
          <label class="check-tile">
            <div>
              <%= check_box_tag "expense[shared_user_ids][]", participant.id, @selected_share_ids.include?(participant.id) %>
              <%= avatar_tag(participant) %>
              <span><%= participant.name %></span>
            </div>
            <%= number_field_tag "expense[share_amounts][#{participant.id}]",
                                 @share_amount_inputs[participant.id.to_s],
                                 step: "0.01",
                                 min: "0.01",
                                 placeholder: "0.00",
                                 class: "share-amount-input" %>
          </label>
        <% end %>
      </div>
    </div>

    <div class="actions-row">
      <%= f.submit(@expense.new_record? ? "Add Expense" : "Save Expense", class: "btn") %>
      <%= link_to "Cancel", trip_path(@trip), class: "btn btn-ghost" %>
    </div>
  <% end %>
</section>
