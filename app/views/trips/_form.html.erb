<section class="card form-card">
  <h1><%= @trip.new_record? ? "Create a Trip" : "Edit Trip" %></h1>
  <p style="margin-bottom: 1.3rem;">
    <%= @trip.new_record? ? "Set the dates and invite the people sharing expenses." : "Update trip details and participants." %>
  </p>

  <% if @trip.errors.any? %>
    <div class="error-box">
      <h2><%= pluralize(@trip.errors.count, "error") %> prevented this trip from being saved:</h2>
      <ul>
        <% @trip.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with(model: @trip) do |f| %>
    <div class="form-grid">
      <div class="field">
        <%= f.label :name, "Trip Name" %>
        <%= f.text_field :name, placeholder: "Pacific Northwest Adventure" %>
      </div>

      <div class="field">
        <%= f.label :start_date, "Start Date" %>
        <%= f.date_field :start_date %>
      </div>

      <div class="field">
        <%= f.label :end_date, "End Date" %>
        <%= f.date_field :end_date %>
      </div>
    </div>

    <div class="field">
      <label>Participants</label>
      <p class="field-help">Trip owner is always included.</p>
      <div class="participant-list">
        <% @available_users.each do |user| %>
          <% checked = user.id == current_user.id || @trip.participants.any? { |p| p.user_id == user.id } %>
          <label class="check-tile">
            <div>
              <%= check_box_tag "trip[participant_user_ids][]", user.id, checked, disabled: user.id == current_user.id %>
              <%= avatar_tag(user) %>
              <span><%= user.name %></span>
            </div>
          </label>
        <% end %>
      </div>
    </div>

    <div class="actions-row">
      <%= f.submit(@trip.new_record? ? "Create Trip" : "Save Changes", class: "btn") %>
      <%= link_to "Cancel", trips_path, class: "btn btn-ghost" %>
    </div>
  <% end %>
</section>
